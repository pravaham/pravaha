{
  "name": "@pravaha/plugin-otel",
  "version": "0.2.0",
  "description": "OpenTelemetry plugin for Pravaha — export pipeline traces as OTEL spans",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pravaha/core": "workspace:*",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/sdk-trace-base": "^1.24.0",
    "@opentelemetry/sdk-trace-node": "^1.24.0",
    "@opentelemetry/resources": "^1.24.0",
    "@opentelemetry/semantic-conventions": "^1.24.0"
  },
  "peerDependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "^0.51.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "^0.51.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "zod": "^3.22.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pravaham/pravaha.git",
    "directory": "packages/plugins/otel"
  },
  "homepage": "https://pravaha.dev",
  "bugs": {
    "url": "https://github.com/pravaham/pravaha/issues"
  },
  "keywords": [
    "pravaha",
    "opentelemetry",
    "otel",
    "tracing",
    "observability",
    "ai",
    "agent"
  ]
}

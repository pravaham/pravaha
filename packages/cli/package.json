{
  "name": "@pravaha/cli",
  "version": "0.1.0",
  "description": "CLI trace inspector for Pravaha pipelines",
  "type": "module",
  "bin": {
    "pravaha": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@pravaha/adapter-trace-fs": "workspace:*",
    "@pravaha/core": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pravaham/pravaha.git",
    "directory": "packages/cli"
  },
  "homepage": "https://pravaha.dev",
  "bugs": {
    "url": "https://github.com/pravaham/pravaha/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "pipeline",
    "pravaha",
    "cli",
    "trace"
  ]
}

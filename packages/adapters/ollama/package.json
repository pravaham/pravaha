{
  "name": "@pravaha/adapter-ollama",
  "version": "0.1.0",
  "description": "Ollama adapter for Pravaha — local model support, zero API cost",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pravaha/core": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pravaham/pravaham.git",
    "directory": "packages/adapters/ollama"
  },
  "homepage": "https://pravaha.dev",
  "bugs": {
    "url": "https://github.com/pravaham/pravaham/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "pipeline",
    "pravaha",
    "ollama",
    "local"
  ]
}
